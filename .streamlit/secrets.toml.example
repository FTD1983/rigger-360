# Plantilla de secretos. NO subir el archivo real "secrets.toml" (está en .gitignore).
#
# En Streamlit Community Cloud: Manage app -> Settings -> Secrets, y pega este bloque
# con tu cadena de conexión real de Supabase.
#
# La cadena se obtiene en Supabase: Project Settings -> Database -> Connection string.
# Usa la cadena del "Connection pooling" (Transaction, puerto 6543) para apps serverless,
# y agrega ?sslmode=require al final.

[postgres]
url = "postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"
